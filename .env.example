# LLM providers
OPENAI_API_KEY=sk-...
# Optional: OpenRouter, used by the eval harness (free models)
OPENROUTER_API_KEY=sk-or-...
# Optional: swap any role to Anthropic via model_config.yaml
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=postgresql+asyncpg://edu:edu@localhost:5432/edu_agent

# Vector store
QDRANT_URL=http://localhost:6333

# LLM observability (optional, `--profile observability`). Leave the keys commented out unless
# Langfuse is running: any real key turns tracing on, and every turn then logs a connection error.
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=http://localhost:3000

# Embedder (BGE-M3 via TEI)
TEI_EMBEDDER_URL=http://localhost:8080
# Dense + sparse (RRF) retrieval; false = dense-only queries. This is NOT a rollback to the
# old collection layout: both modes need the named dense/sparse vectors, so a legacy
# single-vector collection must be recreated and re-ingested (services refuse to start/ingest otherwise).
HYBRID_RETRIEVAL_ENABLED=true
# Reranker (BGE-reranker-v2-m3 via TEI, "reranker" compose profile). Unset = no rerank.
# Containers: http://tei-reranker:8080. Reranks the RRF top-20.
# If the service is down or slow (>2s), retrieval logs a warning and returns the RRF order.
# TEI_RERANKER_URL=http://localhost:8081

# Services (inter-service, Phase 1 localhost)
CORPUS_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_URL=http://localhost:8003

# Math verifier MCP server (SSE on port 8090)
MATH_VERIFIER_URL=http://localhost:8090
# Let the Quant agent call the math_evaluate / math_solve / math_compare tools. Off by default:
# a tool turn is not streamed and costs more tokens. true = the tool loop; false = the original
# single-call streamed path.
MATH_TOOLS_ENABLED=false

# Shared secret for the ingestion service's /admin routes (sent as the X-Admin-Key header).
# Required: while it is empty every /admin request is refused and the seed job fails.
# Generate one: echo "INGESTION_ADMIN_KEY=$(openssl rand -hex 24)" >> .env  (after removing this line)
INGESTION_ADMIN_KEY=

# Admin auth (Phase 1 HTTP Basic)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# IELTS Writing mock (all optional)
# Where attempts are stored (SQLite). Gitignored; docker compose mounts ./ielts-local here.
# IELTS_DATA_DIR=ielts-local
# AI spend cap in USD for the IELTS mock and the evals (not the GRE tutor's /chat), counted in
# one ledger they share; the eval CLIs default to these too. Once it is reached the mock
# refuses to start or mark attempts, with a message saying so. Docker compose mounts
# ./.eval-ledger here so the total survives rebuilds.
# AI_SPEND_CAP_USD=5
# AI_LEDGER_PATH=.eval-ledger/ledger.json
# Independent marking passes per essay; the band is the per-criterion median.
# IELTS_GRADER_SAMPLES=3

# Environment
ENV=dev
# What the gateway does when the OpenAI moderation call fails: closed (answer "safety check
# unavailable") or open (let the turn go on). Default: closed, except open in ENV=dev.
# MODERATION_ON_ERROR=closed
# Dev only (ignored unless ENV=dev): a message containing this text gets the supportive
# self-harm reply, so that path can be tried without an OpenAI moderation key.
# SAFETY_TEST_TRIGGER=__test_self_harm__
# Model config every service reads (default config/model_config.dev.yaml, OpenAI roles).
# config/model_config.free.yaml runs every role on one free OpenRouter model: set
# OPENROUTER_API_KEY, leave OPENAI_API_KEY unset (the OpenAI moderation call is then skipped
# while ENV=dev) and restart the gateway and agent.
# MODEL_CONFIG_PATH=config/model_config.free.yaml
# Opt-in: keep each turn's question (PII redacted) and reply in a local, gitignored file keyed by
# trace id, so a thumbs-down can become a complete draft eval item (python -m evals.feedback_to_item).
# Off by default; the turn log and feedback log never hold message text.
# TURN_CAPTURE_TEXT=1
# TURN_CAPTURE_PATH=.turn-log/capture.jsonl
# FEEDBACK_LOG_PATH=.turn-log/feedback.jsonl
