# LLM providers
OPENAI_API_KEY=sk-...
# Optional: OpenRouter, used by the eval harness (free models)
OPENROUTER_API_KEY=sk-or-...
# Optional: swap any role to Anthropic via model_config.yaml
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=postgresql+asyncpg://edu:edu@localhost:5432/edu_agent

# Vector store
QDRANT_URL=http://localhost:6333

# LLM observability
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://localhost:3000

# Embedder (BGE-M3 via TEI)
TEI_EMBEDDER_URL=http://localhost:8080
# Dense + sparse (RRF) retrieval; false = dense-only queries. This is NOT a rollback to the
# old collection layout: both modes need the named dense/sparse vectors, so a legacy
# single-vector collection must be recreated and re-ingested (services refuse to start/ingest otherwise).
HYBRID_RETRIEVAL_ENABLED=true
# Reranker (BGE-reranker-v2-m3 via TEI, "reranker" compose profile). Unset = no rerank.
# Containers: http://tei-reranker:8080. Reranks the RRF top-20.
# If the service is down or slow (>2s), retrieval logs a warning and returns the RRF order.
# TEI_RERANKER_URL=http://localhost:8081

# Services (inter-service, Phase 1 localhost)
CORPUS_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_URL=http://localhost:8003

# Math verifier MCP server (SSE on port 8090)
MATH_VERIFIER_URL=http://localhost:8090

# Admin auth (Phase 1 HTTP Basic)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# IELTS Writing mock (all optional)
# Where attempts are stored (SQLite). Gitignored; docker compose mounts ./ielts-local here.
# IELTS_DATA_DIR=ielts-local
# Total AI spend cap in USD, counted in one ledger shared with the evals. Once it is reached
# the mock refuses to start or mark attempts, with a message saying so. Docker compose mounts
# ./.eval-ledger here so the total survives rebuilds.
# AI_SPEND_CAP_USD=5
# AI_LEDGER_PATH=.eval-ledger/ledger.json
# Independent marking passes per essay; the band is the per-criterion median.
# IELTS_GRADER_SAMPLES=3

# Environment
ENV=dev
